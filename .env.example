# Karnaf CRM Core - environment template.
# Copy to .env (root) for local dev. Edge Function secrets live in Supabase
# project secrets and never in this repo.

# --- Frontend (Vite, prefixed VITE_*) -----------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_FUNCTIONS_BASE_URL=https://<project-ref>.functions.supabase.co
# Optional Sentry-compatible POST endpoint for unhandled errors. Leaving
# blank disables the global reporters; the helper falls back to no-op.
VITE_SENTRY_DSN=
VITE_RELEASE=
VITE_ENV=production

# --- Backend / Edge Function secrets ------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS allowlist for browser-facing Edge Functions
CORS_ALLOWED_ORIGINS=http://localhost:5173

# WhatsApp / Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Only the OWNER ALERT fallback (operator-alert.ts). The template used for
# customer replies outside the 24h window is set in Settings →
# whatsappSession.fallbackTemplateName (runtime-config), not here.
WHATSAPP_FALLBACK_TEMPLATE=karnaf_followup_v1

# WhatsApp / WATI (only if Meta not used)
WATI_TOKEN=
WATI_API_URL=https://live-mt-server.wati.io

# Webhook HMAC secrets
INTAKE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=

# Internal cron auth. Must equal the Supabase Vault secret `sla_worker_secret`:
# that is the bearer pg_cron sends to sla-worker, nightly-jobs,
# daily-sales-inbox, ai-watchdog, meta-template-status (template sync),
# operator-digest and email-replies-poll. See "Worker secrets" below.
SLA_WORKER_SECRET=

# AI runtime
# Supported values for health/config checks: openai, gemini/google.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Operator alerts (each channel is independent; unset = skipped) -------
# WhatsApp alerts to the owner. ALERT_WHATSAPP_TEMPLATE must be a UTILITY
# template (language he) with fixed text around one {{1}} parameter — Meta
# rejects a body that is only `{{1}}`; the exact body is in
# docs/runbooks/owner-step-by-step.md, problem 11. A MARKETING template is
# refused by Meta after a few per day (error 131049) and the alert is lost.
ALERT_WHATSAPP_TO=
ALERT_WHATSAPP_TEMPLATE=
# Email alerts via Resend. Both default to the email channel settings
# (Settings → ערוץ מייל: sender and forwardTo) when left empty.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_THREAD_ID=

# --- Marketing email (Resend) -------------------------------------------
RESEND_API_KEY=
# Signs the per-lead unsubscribe links. Falls back to the service-role key
# when unset — see docs/runbooks/secret-rotation.md before rotating that key.
EMAIL_UNSUBSCRIBE_SECRET=

# --- Worker secrets (pg_cron → Edge Function bearer) -----------------------
# The cron SQL reads its bearer from Supabase Vault (vault.decrypted_secrets)
# and the Edge Function compares it with the project secret set here. The
# vault name and the fallback differ per worker — there is NO general
# fallback to SLA_WORKER_SECRET:
#
# OUTBOUND_DISPATCH_SECRET — REQUIRED: dispatch-outbound answers 503 when it
#   is unset, no fallback. Must equal vault `outbound_dispatch_secret`
#   (run_outbound_dispatch, migration 042).
# BROADCAST_DISPATCH_SECRET — optional. The function falls back to
#   OUTBOUND_DISPATCH_SECRET; the cron reads vault `broadcast_dispatch_secret`
#   and, when that is absent, `outbound_dispatch_secret` (migration 094).
# AUTOMATION_TICK_SECRET — the cron sends vault `automation_tick_secret`
#   (migration 069); the function also accepts SLA_WORKER_SECRET.
# OPERATOR_DIGEST_SECRET / EMAIL_REPLIES_POLL_SECRET — their crons send vault
#   `sla_worker_secret` (migrations 122 / 135); there is no dedicated vault
#   entry. The functions accept either value, so leave these UNSET unless you
#   also change the cron SQL to send something else.
OUTBOUND_DISPATCH_SECRET=
BROADCAST_DISPATCH_SECRET=
AUTOMATION_TICK_SECRET=
OPERATOR_DIGEST_SECRET=
EMAIL_REPLIES_POLL_SECRET=
# 'live' turns the time-elapsed automation rules on; anything else = dry run
# (the report the ops workflow prints). Enable only after approving each rule.
AUTOMATION_TIME_RULES=

# --- Meta Graph (Instagram DMs, lead ads, CAPI, template sync) ------------
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_EVENT_CODE=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ID=
WHATSAPP_WABA_ID=

# --- Intake lanes ----------------------------------------------------------
INTAKE_STATIC_TOKEN=
PAYMENT_STATIC_TOKEN=
MAKE_INTAKE_KEY=

# --- Rav Messer (legacy email provider; only if email_channel.provider=ravmesser)
RAVMESSER_C_KEY=
RAVMESSER_C_SECRET=
RAVMESSER_U_KEY=
RAVMESSER_U_SECRET=

# --- Student portal provisioning (provision-student) ----------------------
PORTAL_SUPABASE_URL=
PORTAL_SERVICE_ROLE_KEY=
PORTAL_BASE_URL=
